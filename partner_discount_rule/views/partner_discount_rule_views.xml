<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_discount_rule_view_list" model="ir.ui.view">
        <field name="name">partner.discount.rule.list</field>
        <field name="model">partner.discount.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de descuento">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="partner_ids" widget="many2many_tags" optional="show"/>
                <field name="partner_category_ids" widget="many2many_tags" optional="show"/>
                <field name="applied_on"/>
                <field name="discount"/>
                <field name="combine_mode" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="partner_discount_rule_view_form" model="ir.ui.view">
        <field name="name">partner.discount.rule.form</field>
        <field name="model">partner.discount.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de descuento">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej: Promo invierno - Mayoristas"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <group>
                        <group string="Destinatarios">
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="partner_category_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Descuento">
                            <field name="discount"/>
                            <field name="combine_mode" widget="radio"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Aplicabilidad">
                            <field name="applied_on"/>
                            <field name="product_id"
                                   invisible="applied_on != '0_product_variant'"
                                   required="applied_on == '0_product_variant'"/>
                            <field name="product_tmpl_id"
                                   invisible="applied_on != '1_product'"
                                   required="applied_on == '1_product'"/>
                            <field name="categ_id"
                                   invisible="applied_on != '2_product_category'"
                                   required="applied_on == '2_product_category'"/>
                        </group>
                        <group string="Vigencia">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_discount_rule_view_search" model="ir.ui.view">
        <field name="name">partner.discount.rule.search</field>
        <field name="model">partner.discount.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="partner_category_ids"/>
                <filter name="filter_active" string="Vigentes hoy"
                        domain="['&amp;',
                                 '|', ('date_start', '=', False), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 '|', ('date_end', '=', False), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_archived" string="Archivadas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="groupby_applied_on" string="Aplicar sobre"
                            context="{'group_by': 'applied_on'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="partner_discount_rule_action" model="ir.actions.act_window">
        <field name="name">Reglas de descuento</field>
        <field name="res_model">partner.discount.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creá una regla de descuento</p>
            <p>Aplicá un descuento a uno o varios clientes (o a una etiqueta de cliente)
               sobre un producto o categoría, dentro de un rango de fechas.</p>
        </field>
    </record>

    <menuitem id="partner_discount_rule_menu"
              name="Reglas de descuento"
              parent="sale.menu_sales_config"
              action="partner_discount_rule_action"
              groups="sales_team.group_sale_manager"
              sequence="25"/>

</odoo>
